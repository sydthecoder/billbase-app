{
    "baseUrl": "http://localhost:8000/api",
    "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
    },
    "tokens": {
        "auth_token": "REPLACE_WITH_TOKEN_FROM_LOGIN"
    },
    "tests": {
        "1_authentication": {
        "register": {
            "endpoint": "POST /v1/auth/register",
            "description": "Register a new account and create organization",
            "required_fields": [
                "email",
                "password"
            ],
            "optional_fields": [
                "plan_slug"
            ],
            "body": {
                "email": "admin@payflow-test.com",
                "password": "SecurePassword123!",
                "plan_slug": "free"
            },
            "response_note": "Returns user, organization, and api_token. Save token for subsequent requests."
        },
        "login": {
            "endpoint": "POST /v1/auth/login",
            "description": "Login with email and password",
            "required_fields": [
                "email",
                "password"
            ],
            "body": {
                "email": "admin@payflow-test.com",
                "password": "SecurePassword123!"
            },
            "response_note": "Returns api_token. Use in Authorization: Bearer header for all subsequent requests"
        },
        "get_me": {
            "endpoint": "GET /v1/auth/me",
            "description": "Get current authenticated user",
            "auth_required": true,
            "response_note": "Returns current user details including organization_id"
        },
        "logout": {
            "endpoint": "POST /v1/auth/logout",
            "description": "Logout current user",
            "auth_required": true,
            "body": {}
        }
        },
        "2_settings": {
        "get_user_profile": {
            "endpoint": "GET /v1/settings/profile",
            "description": "Get current user profile",
            "auth_required": true
        },
        "update_user_profile": {
            "endpoint": "PUT /v1/settings/profile",
            "description": "Update current user profile",
            "auth_required": true,
            "required_fields": [],
            "optional_fields": [
                "first_name",
                "last_name",
                "phone"
            ],
            "body": {
                "first_name": "Admin",
                "last_name": "User",
                "phone": "0123456789"
            }
        },
        "get_organization": {
            "endpoint": "GET /v1/settings/organization",
            "description": "Get organization profile",
            "auth_required": true
        },
        "update_organization": {
            "endpoint": "PUT /v1/settings/organization",
            "description": "Update organization profile (owner/admin only)",
            "auth_required": true,
            "required_fields": [],
            "optional_fields": [
                "name",
                "email",
                "phone",
                "reg_number",
                "tax_number",
                "street_address",
                "suburb",
                "city",
                "province",
                "postal_code",
                "country",
                "currency"
            ],
            "body": {
                "name": "Test Company Inc",
                "email": "company@payflow-test.com",
                "phone": "0121234567",
                "reg_number": "2024001234",
                "tax_number": "4567890123",
                "street_address": "123 Business Street",
                "suburb": "Sandton",
                "city": "Johannesburg",
                "province": "gauteng",
                "postal_code": "2196",
                "country": "ZA",
                "currency": "ZAR"
            }
        },
        "save_bank_account": {
            "endpoint": "POST /v1/settings/bank-account",
            "description": "Save organization bank account details",
            "auth_required": true,
            "required_fields": [
                "bank_name",
                "account_holder",
                "account_number",
                "branch_code",
                "account_type"
            ],
            "bank_name_options": [
                "absa",
                "fnb",
                "standard_bank",
                "nedbank",
                "capitec",
                "tymebank"
            ],
            "account_type_options": [
                "cheque",
                "savings",
                "transmission"
            ],
            "body": {
            "bank_name": "fnb",
            "account_holder": "Test Company Inc",
            "account_number": "1234567890",
            "branch_code": "250355",
            "account_type": "cheque"
            }
        },
        "get_bank_account": {
            "endpoint": "GET /v1/settings/bank-account",
            "description": "Get organization bank account details",
            "auth_required": true
        },
        "get_preferences": {
            "endpoint": "GET /v1/settings/preferences",
            "description": "Get organization preferences",
            "auth_required": true
        },
        "update_preferences": {
            "endpoint": "PUT /v1/settings/preferences",
            "description": "Update organization preferences",
            "auth_required": true,
            "body": {
                "currency": "ZAR",
                "tax_rate": 15,
                "invoice_prefix": "INV",
                "quote_prefix": "QTE"
            }
        },
        "get_mail_settings": {
            "endpoint": "GET /v1/settings/mail/outgoing",
            "description": "Get outgoing mail settings",
            "auth_required": true
        },
        "save_mail_settings": {
            "endpoint": "POST /v1/settings/mail/outgoing",
            "description": "Save outgoing mail settings",
            "auth_required": true,
            "body": {
                "mail_host": "smtp.gmail.com",
                "mail_port": 587,
                "mail_username": "your-email@gmail.com",
                "mail_password": "your-app-password",
                "mail_encryption": "tls",
                "mail_from_address": "noreply@payflow-test.com",
                "mail_from_name": "PayFlow"
            }
        }
        },
        "3_products_setup": {
        "create_product_category": {
            "endpoint": "POST /v1/products/categories",
            "description": "Create a product category",
            "auth_required": true,
            "required_fields": [
                "name"
            ],
            "optional_fields": [
                "description"
            ],
            "body": [
                {
                    "name": "Services",
                    "description": "Professional services"
                },
                {
                    "name": "Consulting",
                    "description": "Consulting hours"
                },
                {
                    "name": "Development",
                    "description": "Software development"
                }
            ]
        },
        "get_product_categories": {
            "endpoint": "GET /v1/products/categories",
            "description": "List all product categories",
            "auth_required": true
        },
        "create_product": {
            "endpoint": "POST /v1/products",
            "description": "Create a product (use category ID from create_product_category response)",
            "auth_required": true,
            "required_fields": [
                "name",
                "price"
            ],
            "optional_fields": [
                "product_category_id",
                "description",
                "unit",
                "sku",
                "is_taxable",
                "status"
            ],
            "unit_options": [
                "item",
                "hour",
                "day",
                "month",
                "kg",
                "litre",
                "metre"
            ],
            "body": [
                {
                    "product_category_id": "CATEGORY_ID_1",
                    "name": "Consulting - Senior Consultant",
                    "description": "Senior consultant hourly rate",
                    "price": 250.00,
                    "unit": "hour",
                    "sku": "CONS-SC-001",
                    "is_taxable": true,
                    "status": "active"
                },
                {
                    "product_category_id": "CATEGORY_ID_2",
                    "name": "Development - Custom Development",
                    "description": "Custom software development",
                    "price": 150.00,
                    "unit": "hour",
                    "sku": "DEV-CD-001",
                    "is_taxable": true,
                    "status": "active"
                },
                {
                    "product_category_id": "CATEGORY_ID_1",
                    "name": "Project Management",
                    "description": "Monthly project management fee",
                    "price": 5000.00,
                    "unit": "month",
                    "sku": "PM-MTH-001",
                    "is_taxable": true,
                    "status": "active"
                }
            ]
        },
        "get_products": {
            "endpoint": "GET /v1/products",
            "description": "List all products",
            "auth_required": true
        }
        },
        "4_customers": {
