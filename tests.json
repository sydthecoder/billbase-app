        "get_customers": {
            "endpoint": "GET /v1/customers",
            "description": "List all customers",
            "auth_required": true
        },
        "get_customer_by_id": {
            "endpoint": "GET /v1/customers/{id}",
            "description": "Get specific customer (use customer ID from create response)",
            "auth_required": true
        }
        },
        "5_quotes": {
        "create_quote": {
            "endpoint": "POST /v1/quotes",
            "description": "Create a quote (use customer ID and product IDs from previous steps)",
            "auth_required": true,
            "required_fields": [
                "customer_id",
                "issue_date",
                "expires_at",
                "items"
            ],
            "optional_fields": [
                "title",
                "discount_amount",
                "discount_percent",
                "notes",
                "footer"
            ],
            "items_required": [
                "description",
                "quantity",
                "unit_price",
                "is_taxable"
            ],
            "items_optional": [
                "product_id",
                "unit",
                "discount_amount",
                "sort_order"
            ],
            "body": {
            "customer_id": "CUSTOMER_ID_1",
            "title": "Website Redesign Project",
            "issue_date": "2024-06-12",
            "expires_at": "2024-07-12",
            "discount_percent": 5,
            "notes": "Thank you for your business!",
            "footer": "Quote valid for 30 days",
            "items": [
                {
                "product_id": "PRODUCT_ID_2",
                "description": "Custom website development - 80 hours",
                "quantity": 80,
                "unit": "hour",
                "unit_price": 150.00,
                "is_taxable": true,
                "discount_amount": 0,
                "sort_order": 1
                },
                {
                "description": "WordPress theme customization",
                "quantity": 1,
                "unit": "item",
                "unit_price": 5000.00,
                "is_taxable": true,
                "sort_order": 2
                },
                {
                "product_id": "PRODUCT_ID_1",
                "description": "Project management",
                "quantity": 2,
                "unit": "month",
                "unit_price": 5000.00,
                "is_taxable": true,
                "sort_order": 3
                }
            ]
            }
        },
        "get_quotes": {
            "endpoint": "GET /v1/quotes",
            "description": "List all quotes",
            "auth_required": true
        },
        "get_quote_by_id": {
            "endpoint": "GET /v1/quotes/{id}",
            "description": "Get specific quote",
            "auth_required": true
        },
        "update_quote_status": {
            "endpoint": "PATCH /v1/quotes/{id}/status",
            "description": "Update quote status (use quote ID from create response)",
            "auth_required": true,
            "status_options": [
                "draft",
                "sent",
                "viewed",
                "accepted",
                "declined",
                "expired",
                "converted"
            ],
            "body": {
                "status": "sent"
            }
        },
        "get_quote_pdf": {
            "endpoint": "GET /v1/quotes/{id}/pdf",
            "description": "Get quote PDF (returns PDF data)",
            "auth_required": true
        }
        },
        "6_invoices": {
