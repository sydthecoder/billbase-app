            "required_fields": [
                "customer_id",
                "issue_date",
                "due_date",
                "items"
            ],
            "optional_fields": [
                "quote_id",
                "discount_amount",
                "discount_percent",
                "notes",
                "footer"
            ],
            "items_required": [
                "description",
                "quantity",
                "unit_price",
                "is_taxable"
            ],
            "items_optional": [
                "product_id",
                "unit",
                "discount_amount",
                "sort_order"
