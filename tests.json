        "get_invoices": {
            "endpoint": "GET /v1/invoices",
            "description": "List all invoices",
            "auth_required": true
        },
        "get_invoice_by_id": {
            "endpoint": "GET /v1/invoices/{id}",
            "description": "Get specific invoice",
            "auth_required": true
        },
        "send_invoice": {
            "endpoint": "POST /v1/invoices/{id}/send",
            "description": "Send invoice to customer email",
            "auth_required": true,
            "body": {}
        },
        "get_invoice_pdf": {
            "endpoint": "GET /v1/invoices/{id}/pdf",
            "description": "Get invoice PDF (returns PDF data)",
            "auth_required": true,
            "note": "Throttled to 10 requests per minute"
        }
        },
        "7_payments": {
        "create_payment": {
            "endpoint": "POST /v1/invoices/{invoiceId}/payments",
            "description": "Record a payment against an invoice",
            "auth_required": true,
            "required_fields": [
                "payment_method",
                "amount",
                "paid_at"
            ],
            "optional_fields": [
                "notes"
            ],
            "payment_method_options": [
                "eft",
                "cash",
                "other"
            ],
            "body": {
            "payment_method": "eft",
            "amount": 20000.00,
            "paid_at": "2024-06-15",
            "notes": "EFT reference: ACME-20240615"
            }
        },
        "get_invoice_payments": {
            "endpoint": "GET /v1/invoices/{invoiceId}/payments",
            "description": "List all payments for an invoice",
            "auth_required": true
        }
        },
        "8_lookup_data": {
        "get_plans": {
            "endpoint": "GET /v1/plans",
            "description": "Get available plans (no auth required)",
            "auth_required": false
        }
        }
    },
    "usage_notes": {
        "general": [
            "1. Start with Register to create your account",
            "2. Login to get auth token",
            "3. Update organization profile and settings",
            "4. Create product categories",
            "5. Create products",
            "6. Create customers",
            "7. Create quotes",
            "8. Convert quote to invoice or create standalone invoice",
            "9. Record payments against invoices"
        ],
        "authorization": [
            "Add header: Authorization: Bearer {api_token}",
            "Get token from login or register response"
        ],
        "placeholders": {
            "CATEGORY_ID_1": "Replace with category ID from create_product_category response",
            "CATEGORY_ID_2": "Replace with second category ID",
            "PRODUCT_ID_1": "Replace with product ID from create_product response",
            "PRODUCT_ID_2": "Replace with second product ID",
            "CUSTOMER_ID_1": "Replace with customer ID from create_customer response",
            "QUOTE_ID_1": "Replace with quote ID from create_quote response"
        },
        "date_format": "YYYY-MM-DD (ISO 8601)",
        "decimal_fields": "price, amount, tax_rate etc should use max 2 decimal places",
        "status_transitions": {
        "quote": {
            "draft": [
                "sent",
                "deleted"
            ],
            "sent": [
                "viewed",
                "accepted",
                "declined"
            ],
            "viewed": [
                "accepted",
                "declined"
            ],
            "accepted": [
                "converted"
            ],
            "declined": [
                "draft"
            ],
            "converted": "locked - cannot be edited",
            "expired": "locked - cannot be edited"
        },
        "invoice": {
            "draft": [
                "sent",
                "deleted"
            ],
            "sent": [
                "viewed",
                "partial",
                "paid"
            ],
            "viewed": [
                "partial",
                "paid"
            ],
            "partial": [
                "paid"
            ],
            "paid": "locked - cannot be edited"
        }
        },
        "pagination": "Use query parameters: ?page=1&per_page=15",
        "filtering": "Refer to API documentation for available filter parameters"
    }
}
